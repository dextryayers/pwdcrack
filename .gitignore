# Rust
target/

# Alternate cargo target directory used for release and bench builds, because
# target/release is root owned on the development machine. This is build output
# and must never be committed; an earlier commit tracked 600 files from it.
.build/

# Cargo.lock is intentionally committed.
# pwdcrack ships a binary, so every build must resolve to the exact same
# dependency versions. An untracked lock file makes releases unreproducible.

# Build artifacts
*.o
*.so
*.a
*.dylib
*.dll

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Perl
# Note: only build output is ignored here.
# lib/pwdcrack.pm and perl/pwdcrack.xs are sources and must stay tracked,
# so the blanket *.pm and *.xs rules were removed.
blib/
Makefile.old
pm_to_blib

# FPGA
*.bit
*.dcp
*.rpt
*.jou
*.log
*.hw
*.xpr
*.cache/
*.gen/
*.ip_user_files/
sim/*.vcd
sim/*.wdb

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# pwdcrack
pwdcrack.pot
pwdcrack.pot.bak
*.pot
*.pot.*

# Wordlists (too large for repo, download separately)
wordlists/*.txt
wordlists/*.gz

# Config (user overrides)
configs/*.local.toml

# Assembled OpenCL kernel sources, regenerated by engines/engine-opencl/build.rs
target-generated/

# Node addon. `scripts/test-node-bridge.sh` copies the cargo cdylib here under the
# name Node expects, so it is build output. One was committed by accident: 46.6 MB
# of a debug build, in a repository whose Rust archive is already in target/.
engines/engine-bridge/node/pwdcrack.node

# Generated from the XS sources by `perl Makefile.PL`; the Perl script builds in a
# scratch directory so these only appear if someone runs it by hand here.
engines/engine-bridge/perl/Makefile
engines/engine-bridge/perl/pwdcrack.c
engines/engine-bridge/perl/*.o
engines/engine-bridge/perl/*.bs
engines/engine-bridge/perl/MYMETA.*
