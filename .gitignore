# Rust
target/

# Cargo.lock is intentionally committed.
# pwdcrack ships a binary, so every build must resolve to the exact same
# dependency versions. An untracked lock file makes releases unreproducible.

# Build artifacts
*.o
*.so
*.a
*.dylib
*.dll

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Perl
# Note: only build output is ignored here.
# lib/pwdcrack.pm and perl/pwdcrack.xs are sources and must stay tracked,
# so the blanket *.pm and *.xs rules were removed.
blib/
Makefile.old
pm_to_blib

# FPGA
*.bit
*.dcp
*.rpt
*.jou
*.log
*.hw
*.xpr
*.cache/
*.gen/
*.ip_user_files/
sim/*.vcd
sim/*.wdb

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# pwdcrack
pwdcrack.pot
pwdcrack.pot.bak
*.pot
*.pot.*

# Wordlists (too large for repo, download separately)
wordlists/*.txt
wordlists/*.gz

# Config (user overrides)
configs/*.local.toml

# Assembled OpenCL kernel sources, regenerated by engines/engine-opencl/build.rs
target-generated/
